# ==============================================================================
# QueroVagas Crawler (JobsFinder) - Variáveis de Ambiente
# ==============================================================================

# Porta e Host do servidor de API e Dashboard
PORT=3001
HOST=0.0.0.0

# Expressão Cron para execução periódica do crawler (padrão: a cada 30 minutos)
CRON_SCHEDULE=*/30 * * * *

# Endereço do navegador headless Lightpanda (Homelab / Docker)
LIGHTPANDA_HTTP=http://localhost:9222
LIGHTPANDA_WS=ws://localhost:9222

# ==============================================================================
# Integração com Banco Central (Supabase)
# ==============================================================================
# URL do projeto Supabase (Ex: https://xyzcompany.supabase.co)
SUPABASE_URL=

# Chave secreta de serviço (service_role) com permissão de escrita/upsert na tabela jobs
# Encontrada em: Supabase Dashboard > Project Settings > API > service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# ==============================================================================
# Notificações WhatsApp Baileys (Grupo de Distribuição & Digest)
# ==============================================================================
# JID do grupo padrão de destino (Ex: 120363xxxxxx@g.us ou 5519xxxx-xxxx@g.us)
# Atua como fallback global de ambiente à prova de resets no search.config.json
WHATSAPP_GROUP_JID=

# Quantidade mínima de vagas para envio do digest (padrão entry: 1, senior: 4)
DIGEST_ENTRY_MIN_JOBS=1
DIGEST_SENIOR_MIN_JOBS=4


